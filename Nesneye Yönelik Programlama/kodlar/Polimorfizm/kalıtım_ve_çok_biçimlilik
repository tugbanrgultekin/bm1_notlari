//Constructor chaining


class Hayvan extends Object{//SuperClass(Ata Sınıf)
	//extends Object yazsan da yapar, yazmasan da yapar.
	private int yas;
	private String renk;
	private double kutle;
	
	void setYas(int yas) {
		this.yas=yas;
	}
	void setRenk(int yas) {
		this.renk=renk;
	}
	void setKutle(int yas) {
		this.kutle=kutle;
	}
	
	Hayvan(){
		System.out.println("Parametresiz hayvan konstürüktörü");
		yas=0;
		renk="Beyaz";
		kutle=1.0;
	}
	Hayvan(int yas, String renk, double kutle){
		System.out.println("Parametreli hayvan konstürüktörü");
		this.yas=yas;
		this.renk=renk;
		this.kutle=kutle;
	}
	
	void uyu() {
		System.out.println("Hayvan uyuyor.");
	}
	
	private void sesVer() {
		System.out.println("Hayvan ses veriyor.");
	}
	static void sinifAdi() {
		System.out.println("HAYVAN SINIFI");
	}
	
	
	
	
	
}

