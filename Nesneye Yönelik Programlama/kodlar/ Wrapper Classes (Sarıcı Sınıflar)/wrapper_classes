package nyp_16_04;

class Course{
	private String courseName;
	private String[] students = new String[5];
	private int numberOfStudents;
	
	public Course(String sourseName) {
		this.courseName = courseName;
	}
	
	public void addStudent(String student) {
		if(students.length==numberOfStudents) {
			//eğer öğrenci listesi ağzına kadar doluysa 
			String[] students2 = new String[2*numberOfStudents];
			System.arraycopy(students, 0, students2, 0, numberOfStudents);
			students=students2;
		}
		students[numberOfStudents]=student;
		numberOfStudents++;
	}
	public int getStudents() {
		return numberOfStudents;
	}
	
	public String getCourseName() {
		return courseName;
	}
	public void dropStudent(String student) {
		boolean bulundu=false;
		int i;
		
		for(i=0;i<numberOfStudents;i++) {
			if(student.equals(students[i]) {
				bulundu=true;
				break;
				
			}
		}
		if(!bulundu) {
			System.out.println("Silmek istediğiniz öğrenci listede yok!");
		}
		else {
			//i.pozisyonda öğrenciyi bul
			System.arraycopy(students, i+1, students2,i , numberOfStudents-i-1);
			students[numberOfStudents-1]=null;
			numberOfStudents--;
			System.out.println(student+"isimli öğrenciyi sildik");
		}
	}
}

